{
  "name": "ram-tow",
  "compatibility_date": "2026-08-21",
  "main": "src/worker.mjs",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PERKINS_INVENTORY_SNAPSHOT",
        "class_name": "PerkinsInventorySnapshot"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-perkins-inventory-snapshot",
      "new_sqlite_classes": ["PerkinsInventorySnapshot"]
    }
  ],
  "triggers": {
    "crons": ["20 */4 * * *"]
  },
  "vars": {
    "GA_MEASUREMENT_ID": "G-FXRKJ81DXP"
  }
}
